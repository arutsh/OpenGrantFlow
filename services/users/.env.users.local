ENV=local
DEBUG=True
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=grandflow-db
POSTGRES_PORT=5432
USERS_DATABASE_URL=postgresql://postgres:postgres@grandflow-db:5432/grandflow_users
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=grandflow.events
LOG_LEVEL=INFO
AI_SERVICE_URL=http://ai:8002/api/v1
BUDGET_SERVICE_URL=http://budget:8000/api/v1
# Dev-only fixed value — must match budget's INTERNAL_SERVICE_TOKEN exactly.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token
EXPOSE_VERIFICATION_TOKEN_FOR_TESTS=true
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=grantflow-reports-dev