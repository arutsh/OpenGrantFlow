ENV=production
DEBUG=False
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=${POSTGRES_DB}
POSTGRES_HOST=grandflow-db
POSTGRES_PORT=5432
POSTGRES_DB_NAME=grandflow_ai
AI_DATABASE_URL=${AI_DATABASE_URL}

ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=${ENCRYPTION_KEY}
OLLAMA_MODEL=llama3.2
AI_RATE_LIMIT_PER_HOUR=100
REDIS_URL=redis://redis:6379
LOG_LEVEL=INFO
# Must match the users/budget services' JWT_SECRET_KEY exactly — ai validates
# tokens issued by users via shared.security.dependencies.get_validated_user.
JWT_SECRET_KEY=${JWT_SECRET_KEY}
# Grafana Cloud OTLP gateway — see docs/observability/GRAFANA_CLOUD_PRODUCTION.md.
# Safe to leave blank locally; shared/observability falls back to localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=${GRAFANA_CLOUD_OTLP_ENDPOINT}
OTEL_EXPORTER_OTLP_HEADERS=${GRAFANA_CLOUD_OTLP_HEADERS}
SITE_ASSISTANT_ENABLED=false
SITE_ASSISTANT_PROVIDER=anthropic
SITE_ASSISTANT_LINK_HOSTS=opengrantflow.com,www.opengrantflow.com
