ENV=development
DEBUG=True
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
BUDGET_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grandflow_budget
REDIS_URL=redis://localhost:6379/0
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=grantflow-reports-dev
USER_ALL_SERVICES_URL=http://localhost:8000/api/
CUSTOMER_SERVICE_URL=${USER_ALL_SERVICES_URL}customers/
DONOR_GRANTEE_SERVICE_URL=${USER_ALL_SERVICES_URL}donor-grantees/
USER_SERVICE_URL=${USER_ALL_SERVICES_URL}users/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=grandflow.events
RABBITMQ_QUEUE=user_events.budget_service
LOG_LEVEL=INFO
# Dev-only fixed value — must match users' INTERNAL_SERVICE_TOKEN exactly.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token