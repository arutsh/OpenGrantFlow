{
	# Set a real contact email so Let's Encrypt can notify you of cert issues.
	email admin@opengrantflow.com
}

# Retry dial failures while a deploy swaps an upstream container, instead of returning 502.
(upstream_retry) {
	lb_try_duration 15s
	lb_try_interval 500ms
}

api.opengrantflow.com {
	@allowed_apex header Origin https://opengrantflow.com
	@allowed_www header Origin https://www.opengrantflow.com
	@cors_preflight method OPTIONS

	# ---- CORS ----
	header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
	header Access-Control-Allow-Headers "Content-Type, Authorization"
	header Access-Control-Allow-Credentials "true"
	# Custom response headers are invisible to browser JS unless explicitly exposed —
	# without this, the frontend can never read X-Session-Id and every chat turn
	# starts a brand-new session with no history.
	header Access-Control-Expose-Headers "X-Session-Id, X-Conversation-Id"
	header @allowed_apex Access-Control-Allow-Origin "https://opengrantflow.com"
	header @allowed_www Access-Control-Allow-Origin "https://www.opengrantflow.com"

	handle @cors_preflight {
		respond 204
	}

	# ---- AI SETTINGS (proxied through users service) ----
	# The bare base path is split from its sub-paths because handle_path
	# normalizes an empty leftover ("" after stripping the matched prefix)
	# to "/" — that trailing slash mismatches the FastAPI route (registered
	# without one)
	handle /api/v1/users/me/ai-settings {
		rewrite * /api/users/me/ai-settings
		reverse_proxy users:8000 {
			import upstream_retry
		}
	}

	handle_path /api/v1/users/me/ai-settings/* {
		rewrite * /api/users/me/ai-settings{uri}
		reverse_proxy users:8000 {
			import upstream_retry
		}
	}

	# ---- AUTH SERVICE ----
	handle_path /api/v1/auth/* {
		rewrite * /api/auth{uri}
		reverse_proxy users:8000 {
			import upstream_retry
		}
	}

	# ---- USER REGISTRATION ----
	# No {uri} here — this is a single fixed endpoint, not a path prefix.
	handle_path /api/v1/register* {
		rewrite * /api/register
		reverse_proxy users:8000 {
			import upstream_retry
		}
	}

	# ---- USERS SERVICE (health) ----
	# Most specific path first — a single fixed endpoint, not a path prefix.
	handle_path /api/v1/users/health* {
		rewrite * /health
		reverse_proxy users:8000 {
			import upstream_retry
		}
	}

	# ---- USERS SERVICE (deny internal-only batch lookup) ----
	# by_ids is for service-to-service calls on the Docker network only, never public.
	handle_path /api/v1/users/by_ids* {
		respond 404
	}

	# ---- USERS SERVICE ----
	handle_path /api/v1/users/* {
		rewrite * /api/users{uri}
		reverse_proxy users:8000 {
			import upstream_retry
		}
	}

	# ---- DONOR-GRANTEE RELATIONSHIPS ----
	handle_path /api/v1/donor-grantees/* {
		rewrite * /api/donor-grantees{uri}
		reverse_proxy users:8000 {
			import upstream_retry
		}
	}

	# ---- CUSTOMERS ----
	handle_path /api/v1/customers/* {
		rewrite * /api/customers{uri}
		reverse_proxy users:8000 {
			import upstream_retry
		}
	}

	# ---- BUG REPORTS ----
	handle_path /api/v1/bug-reports/* {
		rewrite * /api/bug-reports{uri}
		reverse_proxy users:8000 {
			import upstream_retry
		}
	}

	# ---- BUDGET SERVICE (health) ----
	# Most specific path first — a single fixed endpoint, not a path prefix.
	handle_path /api/v1/budgets/health* {
		rewrite * /health
		reverse_proxy budget:8000 {
			import upstream_retry
		}
	}

	# ---- BUDGET SERVICE ----
	handle /api/v1/budgets/* {
		reverse_proxy budget:8000 {
			import upstream_retry
		}
	}

	# ---- BUDGET LINES SERVICE ----
	handle /api/v1/budget-lines/* {
		reverse_proxy budget:8000 {
			import upstream_retry
		}
	}

	# ---- BUDGET CATEGORIES SERVICE ----
	handle /api/v1/budget-categories/* {
		reverse_proxy budget:8000 {
			import upstream_retry
		}
	}

	# ---- REPORTS SERVICE ----
	handle /api/v1/reports/* {
		reverse_proxy budget:8000 {
			import upstream_retry
		}
	}

	# ---- REPORT LINES SERVICE ----
	handle /api/v1/report-lines/* {
		reverse_proxy budget:8000 {
			import upstream_retry
		}
	}

	# ---- ATTACHMENTS SERVICE ----
	handle /api/v1/attachments/* {
		reverse_proxy budget:8000 {
			import upstream_retry
		}
	}

	# ---- FUNDING RECEIPTS SERVICE ----
	handle /api/v1/funding-receipts/* {
		reverse_proxy budget:8000 {
			import upstream_retry
		}
	}

	# ---- CURRENCY CONVERSIONS SERVICE ----
	handle /api/v1/currency-conversions/* {
		reverse_proxy budget:8000 {
			import upstream_retry
		}
	}

	# ---- AI SERVICE ----
	handle /api/v1/ai/* {
		reverse_proxy ai:8000 {
			import upstream_retry
			flush_interval -1
		}
	}

	# ---- CHAT SERVICE (health only for now — SSE endpoints land in ticket #92) ----
	# Most specific path first — a single fixed endpoint, not a path prefix.
	handle_path /api/v1/chat/health* {
		rewrite * /health
		reverse_proxy chat:8000 {
			import upstream_retry
		}
	}

	handle /api/v1/chat/* {
		reverse_proxy chat:8000 {
			import upstream_retry
			flush_interval -1
		}
	}

	handle {
		respond 404
	}
}
