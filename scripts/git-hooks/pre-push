#!/usr/bin/env bash
# Mirrors .github/workflows/{ai,budget,chat,users,shared,tooling,worker}.yml's lint
# steps locally, scoped to whatever's actually being pushed. See
# docs/development/WORKFLOW.md for setup (git config core.hooksPath).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

zero="0000000000000000000000000000000000000000"
# <Service>/<type>/Issue-<sub-issue>/<description>, see docs/development/WORKFLOW.md §2
branch_name_re='^[A-Z][A-Za-z]*/(feat|fix|chore|refactor)/Issue-[0-9]+/.+$'
declare -A areas=()

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue  # deleting a branch

  branch="${local_ref#refs/heads/}"
  if [[ "$branch" != "main" && ! "$branch" =~ $branch_name_re ]]; then
    echo "error: branch '${branch}' doesn't match <Service>/<type>/Issue-<n>/<description>" >&2
    echo "       create branches with scripts/flow.py start <change-name> <N> (docs/development/WORKFLOW.md)" >&2
    exit 1
  fi

  if [[ "$remote_sha" == "$zero" ]]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
  else
    base="$remote_sha"
  fi

  if [[ -z "$base" ]]; then
    changed=$(git diff --name-only --diff-filter=ACM "$local_sha" -- '*.py' || true)
  else
    changed=$(git diff --name-only --diff-filter=ACM "$base" "$local_sha" -- '*.py' || true)
  fi

  [[ -z "$changed" ]] && continue

  while IFS= read -r f; do
    case "$f" in
      services/ai/*) areas["ai"]=1 ;;
      services/budget/*) areas["budget"]=1 ;;
      services/chat/*) areas["chat"]=1 ;;
      services/users/*) areas["users"]=1 ;;
      services/worker/*) areas["worker"]=1 ;;
      scripts/*) areas["scripts"]=1 ;;
      shared/*) areas["ai"]=1; areas["budget"]=1; areas["chat"]=1; areas["users"]=1; areas["shared"]=1 ;;
    esac
  done <<< "$changed"
done

if [[ ${#areas[@]} -eq 0 ]]; then
  exit 0
fi

fail=0

run() {
  echo "-> $*"
  if ! "$@"; then
    fail=1
  fi
}

for area in "${!areas[@]}"; do
  case "$area" in
    ai|budget|chat|users)
      echo "== services/$area =="
      run black --check "services/$area/app"
      run mypy "services/$area/app"
      run flake8 "services/$area/app"
      ;;
    worker)
      echo "== services/worker =="
      pushd services/worker > /dev/null
      run black --check .
      run flake8 .
      popd > /dev/null
      ;;
    shared)
      echo "== shared =="
      run black --check shared/ai_client shared/tests
      run flake8 --max-line-length=100 shared/ai_client shared/tests
      ;;
    scripts)
      echo "== scripts =="
      run black --check scripts/
      run flake8 --max-line-length=100 scripts/
      run python3 -m pytest scripts/test_flow.py -q
      ;;
  esac
done

if [[ "$fail" -ne 0 ]]; then
  echo
  echo "pre-push lint failed — fix the above before pushing (or 'git push --no-verify' to skip)."
  exit 1
fi
